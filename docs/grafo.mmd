---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	decidir(decidir)
	ejecutar_herramienta(ejecutar_herramienta)
	pedir_aprobacion(pedir_aprobacion)
	responder(responder)
	__end__([<p>__end__</p>]):::last
	__start__ --> decidir;
	decidir -.-> ejecutar_herramienta;
	decidir -.-> pedir_aprobacion;
	decidir -.-> responder;
	ejecutar_herramienta --> decidir;
	pedir_aprobacion -.-> ejecutar_herramienta;
	pedir_aprobacion -.-> responder;
	responder --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
